generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String                @unique
  fullName            String                @map("full_name")
  passwordHash        String                @map("password_hash")
  status              String                @default("active")
  memberships         WorkspaceMembership[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  preferences         UserPreferences?
  createdInvitations  WorkspaceInvitation[] @relation("InvitationCreator")
  createdQuotations   Quotation[]           @relation("QuotationCreator")
  createdPayments     Payment[]             @relation("PaymentCreator")
  notifications       Notification[]
  auditLogs           AuditLog[]
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@map("users")
}

model Workspace {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String
  slug                String                @unique
  companyName         String                @map("company_name")
  billingEmail        String                @map("billing_email")
  phone               String?
  address             String?
  taxId               String?               @map("tax_id")
  defaultCurrency     String                @default("USD") @map("default_currency") @db.Char(3)
  memberships         WorkspaceMembership[]
  products            Product[]
  plans               Plan[]
  customers           Customer[]
  quotations          Quotation[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  discounts           Discount[]
  payments            Payment[]
  invitations         WorkspaceInvitation[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  discountRedemptions DiscountRedemption[]
  taxSettings         WorkspaceTaxSettings?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@map("workspaces")
}

model WorkspaceMembership {
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @default("member")
  status      String    @default("active")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([workspaceId, userId])
  @@map("workspace_memberships")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")

  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model WorkspaceInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String
  role        String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdById String?   @map("created_by") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

model UserPreferences {
  userId             String   @id @map("user_id") @db.Uuid
  currency           String   @default("USD") @db.Char(3)
  timezone           String   @default("UTC")
  dateFormat         String   @default("YYYY-MM-DD") @map("date_format")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  productNumber  String           @map("product_number")
  name           String
  type           String
  description    String?
  salesPrice     Decimal          @map("sales_price") @db.Decimal(12, 2)
  costPrice      Decimal          @map("cost_price") @db.Decimal(12, 2)
  currency       String           @default("USD") @db.Char(3)
  status         String           @default("active")
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  variants       ProductVariant[]
  plans          Plan[]
  discounts      Discount[]       @relation("DiscountProducts")
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  @@unique([workspaceId, id])
  @@unique([workspaceId, productNumber])
  @@index([workspaceId, status])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  name            String
  additionalPrice Decimal  @default(0) @map("additional_price") @db.Decimal(12, 2)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([productId, name])
  @@map("product_variants")
}

model Plan {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  planNumber        String          @map("plan_number")
  name              String
  intervalUnit      String          @map("interval_unit")
  intervalCount     Int             @default(1) @map("interval_count")
  price             Decimal         @db.Decimal(12, 2)
  currency          String          @default("USD") @db.Char(3)
  minimumQuantity   Int             @default(1) @map("minimum_quantity")
  availableFrom     DateTime?       @map("available_from") @db.Date
  availableUntil    DateTime?       @map("available_until") @db.Date
  autoClose         Boolean         @default(false) @map("auto_close")
  allowEarlyClosure Boolean         @default(false) @map("allow_early_closure")
  allowPause        Boolean         @default(false) @map("allow_pause")
  allowRenewal      Boolean         @default(true) @map("allow_renewal")
  status            String          @default("active")
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions     Subscription[]
  discounts         Discount[]      @relation("DiscountPlans")
  quotationItems    QuotationItem[]
  invoiceItems      InvoiceItem[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  @@unique([workspaceId, id])
  @@unique([workspaceId, planNumber])
  @@index([workspaceId, status])
  @@map("plans")
}

model Customer {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  customerNumber      String               @map("customer_number")
  name                String
  email               String
  phone               String?
  companyName         String?              @map("company_name")
  address             String?
  location            String?
  status              String               @default("active")
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  quotations          Quotation[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  payments            Payment[]
  discountRedemptions DiscountRedemption[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  @@unique([workspaceId, id])
  @@unique([workspaceId, customerNumber])
  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@map("customers")
}

model Quotation {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  quoteNumber         String               @map("quote_number")
  customerId          String               @map("customer_id") @db.Uuid
  createdById         String?              @map("created_by") @db.Uuid
  createdOn           DateTime             @default(now()) @map("created_on") @db.Date
  validUntil          DateTime             @map("valid_until") @db.Date
  status              String               @default("draft")
  currency            String               @default("USD") @db.Char(3)
  subtotal            Decimal              @db.Decimal(12, 2)
  taxTotal            Decimal              @map("tax_total") @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  notes               String?
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy           User?                @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items               QuotationItem[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  discountRedemptions DiscountRedemption[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([workspaceId, id])
  @@unique([workspaceId, quoteNumber])
  @@index([workspaceId, status])
  @@map("quotations")
}

model QuotationItem {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  quotationId         String    @map("quotation_id") @db.Uuid
  productId           String?   @map("product_id") @db.Uuid
  planId              String?   @map("plan_id") @db.Uuid
  descriptionSnapshot String    @map("description_snapshot")
  quantity            Int
  unitPrice           Decimal   @map("unit_price") @db.Decimal(12, 2)
  taxRate             Decimal   @map("tax_rate") @db.Decimal(7, 4)
  lineSubtotal        Decimal   @map("line_subtotal") @db.Decimal(12, 2)
  taxAmount           Decimal   @map("tax_amount") @db.Decimal(12, 2)
  lineTotal           Decimal   @map("line_total") @db.Decimal(12, 2)
  quotation           Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan                Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("quotation_items")
}

model Subscription {
  id                 String     @id @default(uuid()) @db.Uuid
  workspaceId        String     @map("workspace_id") @db.Uuid
  subscriptionNumber String     @map("subscription_number")
  customerId         String     @map("customer_id") @db.Uuid
  planId             String     @map("plan_id") @db.Uuid
  quotationId        String?    @map("quotation_id") @db.Uuid
  startsOn           DateTime   @map("starts_on") @db.Date
  expiresOn          DateTime?  @map("expires_on") @db.Date
  nextBillingOn      DateTime?  @map("next_billing_on") @db.Date
  intervalUnit       String     @map("interval_unit")
  intervalCount      Int        @default(1) @map("interval_count")
  amount             Decimal    @db.Decimal(12, 2)
  currency           String     @default("USD") @db.Char(3)
  status             String     @default("draft")
  pausedAt           DateTime?  @map("paused_at")
  cancelledAt        DateTime?  @map("cancelled_at")
  workspace          Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  customer           Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan               Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotation          Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@unique([workspaceId, id])
  @@unique([workspaceId, subscriptionNumber])
  @@unique([workspaceId, quotationId])
  @@index([workspaceId, status])
  @@index([workspaceId, nextBillingOn])
  @@map("subscriptions")
}

model Invoice {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  invoiceNumber       String               @map("invoice_number")
  customerId          String               @map("customer_id") @db.Uuid
  subscriptionId      String?              @map("subscription_id") @db.Uuid
  quotationId         String?              @map("quotation_id") @db.Uuid
  issueDate           DateTime             @map("issue_date") @db.Date
  dueDate             DateTime             @map("due_date") @db.Date
  status              String               @default("draft")
  currency            String               @default("USD") @db.Char(3)
  subtotal            Decimal              @db.Decimal(12, 2)
  taxTotal            Decimal              @map("tax_total") @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  notes               String?
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  quotation           Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items               InvoiceItem[]
  payments            Payment[]
  discountRedemptions DiscountRedemption[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([workspaceId, id])
  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  invoiceId           String   @map("invoice_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  planId              String?  @map("plan_id") @db.Uuid
  descriptionSnapshot String   @map("description_snapshot")
  quantity            Int
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRate             Decimal  @map("tax_rate") @db.Decimal(7, 4)
  lineSubtotal        Decimal  @map("line_subtotal") @db.Decimal(12, 2)
  taxAmount           Decimal  @map("tax_amount") @db.Decimal(12, 2)
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan                Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("invoice_items")
}

model Discount {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  discountNumber  String               @map("discount_number")
  name            String
  code            String?
  type            String
  value           Decimal              @db.Decimal(12, 2)
  minimumPurchase Decimal?             @map("minimum_purchase") @db.Decimal(12, 2)
  minimumQuantity Int?                 @map("minimum_quantity")
  startsOn        DateTime?            @map("starts_on") @db.Date
  endsOn          DateTime?            @map("ends_on") @db.Date
  usageLimit      Int?                 @map("usage_limit")
  appliesTo       String               @map("applies_to")
  status          String               @default("active")
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  products        Product[]            @relation("DiscountProducts")
  plans           Plan[]               @relation("DiscountPlans")
  redemptions     DiscountRedemption[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@unique([workspaceId, code])
  @@unique([workspaceId, discountNumber])
  @@index([workspaceId, status])
  @@map("discounts")
}

model DiscountRedemption {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  discountId  String     @map("discount_id") @db.Uuid
  customerId  String     @map("customer_id") @db.Uuid
  quotationId String?    @map("quotation_id") @db.Uuid
  invoiceId   String?    @map("invoice_id") @db.Uuid
  redeemedAt  DateTime   @default(now()) @map("redeemed_at")
  amount      Decimal    @db.Decimal(12, 2)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  discount    Discount   @relation(fields: [discountId], references: [id], onDelete: Restrict)
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, discountId])
  @@map("discount_redemptions")
}

model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  paymentNumber     String    @map("payment_number")
  customerId        String    @map("customer_id") @db.Uuid
  createdById       String?   @map("created_by") @db.Uuid
  invoiceId         String?   @map("invoice_id") @db.Uuid
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD") @db.Char(3)
  method            String
  status            String    @default("pending")
  paidAt            DateTime? @map("paid_at")
  externalReference String?   @map("external_reference")
  provider          String?
  providerPaymentId String?   @map("provider_payment_id")
  notes             String?
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy         User?     @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, id])
  @@unique([workspaceId, paymentNumber])
  @@index([workspaceId, status])
  @@map("payments")
}

model WorkspaceTaxSettings {
  workspaceId String    @id @map("workspace_id") @db.Uuid
  taxName     String    @map("tax_name")
  taxRate     Decimal   @map("tax_rate") @db.Decimal(7, 4)
  taxId       String?   @map("tax_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("workspace_tax_settings")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  title       String
  body        String
  readAt      DateTime? @map("read_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  metadata    Json      @default("{}")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}
